# Copy to backend/.env for local development. Never commit real credentials.
APP_ENV=development
LOG_LEVEL=debug
HTTP_PORT=8080

MYSQL_DSN=root:replace-me@tcp(127.0.0.1:3306)/cbizdocsmanager?charset=utf8mb4&parseTime=true&loc=UTC
MYSQL_MAX_OPEN_CONNS=20
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME=30m

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=cbizdocsmanager
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=168h

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-ID,X-CSRF-Token
CORS_ALLOW_CREDENTIALS=true

WEB_AUTH_ENABLED=true
WEB_AUTH_SECURE=false
WEB_AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WEB_AUTH_COOKIE_DOMAIN=
WEB_AUTH_REFRESH_COOKIE_NAME=cbiz_refresh
WEB_AUTH_CSRF_COOKIE_NAME=cbiz_csrf

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-me

# Base64 encoding of exactly 32 random bytes. Required in every environment.
INVITATION_ENCRYPTION_KEY=replace-with-base64-32-byte-key
